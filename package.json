{
    "name": "@reloaddk/wsdl-tsclient",
    "version": "2.0.2",
    "description": "Generate typescript soap client with typescript definitions from WSDL file.",
    "main": "dist/src/index.js",
    "bin": {
        "wsdl-tsclient": "dist/src/cli.js"
    },
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "pretest": "rm -rf ./test/generated",
        "test": "node --test --import=tsx test/**/*.test.ts",
        "preversion": "npm test && npm run build",
        "prepublishOnly": "npm test && npm run dist",
        "dev": "tsx ./dev.ts",
        "dist": "tsc",
        "build": "tsc",
        "lint": "eslint",
        "lint:fix": "eslint --fix"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/reload/wsdl-tsclient.git"
    },
    "keywords": [
        "soap",
        "soap-client",
        "wsdl",
        "wsdl-client",
        "typescript"
    ],
    "author": "Daniel Derevjanik <daniel.derevjanik@gmail.com>",
    "contributers": [
        {
            "name": "Daniel Derevjanik",
            "email": "daniel.derevjanik@gmail.com"
        },
        {
            "name": "Sander Hurlen",
            "email": "sander.hurlen@icloud.com"
        },
        {
            "name": "Arne Jørgensen",
            "email": "arne@reload.dk"
        }
    ],
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/reload/wsdl-tsclient/issues"
    },
    "homepage": "https://github.com/reload/wsdl-tsclient#readme",
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.3.0",
        "@types/yargs": "^17.0.35",
        "@typescript-eslint/eslint-plugin": "^8.56.0",
        "@typescript-eslint/parser": "^8.56.0",
        "eslint": "^10.0.1",
        "eslint-plugin-prettier": "^5.5.5",
        "globals": "^17.3.0",
        "prettier": "^3.8.1",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "dependencies": {
        "camelcase": "^9.0.0",
        "chalk": "^5.6.2",
        "sanitize-filename": "^1.6.3",
        "soap": "^1.7.1",
        "supports-color": "^10.2.2",
        "ts-morph": "^28.0.0",
        "yargs": "^18.0.0"
    },
    "directories": {
        "doc": "docs",
        "test": "test"
    },
    "types": "./dist/src/index.d.ts"
}
